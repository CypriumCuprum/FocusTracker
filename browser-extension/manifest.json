{
  "manifest_version": 3,
  "name": "FocusTracker Extension",
  "version": "1.4",
  "description": "Tracks time spent on social media and reports to FocusTracker desktop app.",
  "permissions": [
    "tabs",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "FocusTracker"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "focustracker@cup.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}